<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1, viewport-fit=cover"
  >
  <meta name="theme-color" content="#f8d9df">
  <title>La comunione di Martina</title>

  <style>
    :root {
      --rosa: #f9d9e1;
      --rosa-scuro: #d87993;
      --rosa-intenso: #bd496d;
      --crema: #fffaf4;
      --oro: #c9a35e;
      --testo: #563f45;
      --bianco: #ffffff;
      --ombra: 0 10px 30px rgba(113, 58, 73, 0.16);
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      min-width: 320px;
      color: var(--testo);
      font-family: Arial, Helvetica, sans-serif;
      background:
        radial-gradient(circle at top left, #fff 0, transparent 28%),
        linear-gradient(135deg, #fff9fa 0%, #f8d9e1 48%, #fff8ef 100%);
      overflow-x: hidden;
    }

    button {
      font: inherit;
    }

    .pagina {
      width: min(100%, 760px);
      min-height: 100vh;
      margin: 0 auto;
      padding: 20px 16px 42px;
    }

    .hero {
      position: relative;
      overflow: hidden;
      text-align: center;
      padding: 42px 20px 32px;
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.8);
      box-shadow: var(--ombra);
    }

    .hero::before,
    .hero::after {
      position: absolute;
      color: rgba(216, 121, 147, 0.12);
      font-size: 170px;
      line-height: 1;
      z-index: 0;
    }

    .hero::before {
      content: "✦";
      top: -42px;
      left: -30px;
    }

    .hero::after {
      content: "♥";
      right: -32px;
      bottom: -54px;
    }

    .contenuto-hero {
      position: relative;
      z-index: 1;
    }

    .croce {
      display: block;
      margin-bottom: 12px;
      color: var(--oro);
      font-size: 42px;
      animation: pulsa 2.4s ease-in-out infinite;
    }

    h1,
    h2,
    p {
      margin-top: 0;
    }

    h1 {
      margin-bottom: 10px;
      color: var(--rosa-intenso);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(2.1rem, 8vw, 3.8rem);
      line-height: 1.05;
    }

    .sottotitolo {
      max-width: 510px;
      margin: 0 auto;
      font-size: clamp(1rem, 3.8vw, 1.25rem);
      line-height: 1.6;
    }

    .cuore {
      color: var(--rosa-intenso);
    }

    .pulsante {
      display: inline-block;
      border: 0;
      border-radius: 999px;
      padding: 14px 22px;
      cursor: pointer;
      color: var(--bianco);
      background: linear-gradient(135deg, var(--rosa-scuro), var(--rosa-intenso));
      box-shadow: 0 7px 18px rgba(189, 73, 109, 0.28);
      font-weight: 700;
      text-decoration: none;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .pulsante:hover,
    .pulsante:focus-visible {
      transform: translateY(-2px);
      box-shadow: 0 11px 24px rgba(189, 73, 109, 0.34);
    }

    .pulsante:active {
      transform: scale(0.97);
    }

    .pulsante-hero {
      margin-top: 24px;
    }

    .sezione {
      margin-top: 26px;
      padding: 25px 18px;
      border-radius: 28px;
      background: rgba(255, 255, 255, 0.85);
      box-shadow: var(--ombra);
    }

    h2 {
      margin-bottom: 8px;
      color: var(--rosa-intenso);
      font-family: Georgia, "Times New Roman", serif;
      font-size: clamp(1.65rem, 6vw, 2.25rem);
      text-align: center;
    }

    .introduzione {
      max-width: 560px;
      margin: 0 auto 22px;
      text-align: center;
      line-height: 1.6;
    }

    .griglia-giochi {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }

    .scheda-gioco {
      min-height: 180px;
      padding: 18px 13px;
      border: 1px solid rgba(216, 121, 147, 0.16);
      border-radius: 22px;
      text-align: center;
      background: linear-gradient(180deg, #fff 0%, #fff8fa 100%);
    }

    .icona-gioco {
      display: block;
      margin-bottom: 7px;
      font-size: 42px;
    }

    .scheda-gioco h3 {
      margin: 0 0 8px;
      color: var(--rosa-intenso);
      font-size: 1.05rem;
    }

    .scheda-gioco p {
      min-height: 42px;
      margin-bottom: 13px;
      font-size: 0.92rem;
      line-height: 1.4;
    }

    .pulsante-piccolo {
      padding: 10px 14px;
      font-size: 0.9rem;
    }

    .area-gioco {
      display: none;
      margin-top: 18px;
      padding: 20px 14px;
      border: 2px dashed rgba(216, 121, 147, 0.34);
      border-radius: 22px;
      text-align: center;
      background: #fffdfd;
    }

    .area-gioco.attiva {
      display: block;
      animation: comparsa 0.3s ease;
    }

    .chiudi-gioco {
      float: right;
      border: 0;
      cursor: pointer;
      color: var(--rosa-intenso);
      background: transparent;
      font-size: 1.45rem;
      line-height: 1;
    }

    .area-gioco h3 {
      margin: 10px 0 8px;
      color: var(--rosa-intenso);
      font-size: 1.35rem;
    }

    .messaggio-gioco {
      min-height: 25px;
      margin: 12px 0 0;
      font-weight: 700;
    }

    .carte {
      display: grid;
      grid-template-columns: repeat(4, minmax(48px, 76px));
      justify-content: center;
      gap: 9px;
      margin: 18px auto 10px;
    }

    .carta {
      aspect-ratio: 1 / 1;
      border: 0;
      border-radius: 14px;
      cursor: pointer;
      color: transparent;
      background: linear-gradient(135deg, #eaa1b5, #c95c7b);
      box-shadow: 0 3px 8px rgba(130, 52, 74, 0.2);
      font-size: clamp(1.35rem, 7vw, 2.1rem);
      transition: transform 0.2s ease, background 0.2s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .carta:active {
      transform: scale(0.94);
    }

    .carta.scoperta,
    .carta.trovata {
      color: inherit;
      background: #fff4f6;
    }

    .carta.trovata {
      border: 2px solid #e8bd75;
      background: #fff9e8;
    }

    .stella {
      position: relative;
      display: block;
      width: min(100%, 450px);
      height: 250px;
      margin: 15px auto 10px;
      overflow: hidden;
      border-radius: 20px;
      touch-action: manipulation;
      background:
        radial-gradient(circle at 30% 25%, rgba(255,255,255,0.7) 0 2px, transparent 3px),
        radial-gradient(circle at 68% 35%, rgba(255,255,255,0.55) 0 2px, transparent 3px),
        linear-gradient(145deg, #f3b4c4, #dc7894);
    }

    .stella-bersaglio {
      position: absolute;
      display: grid;
      width: 55px;
      height: 55px;
      place-items: center;
      cursor: pointer;
      border: 0;
      border-radius: 50%;
      color: #fff;
      background: rgba(255, 255, 255, 0.22);
      font-size: 32px;
      transition: transform 0.12s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .stella-bersaglio:active {
      transform: scale(0.86);
    }

    .quiz-domanda {
      margin: 16px auto;
      color: var(--testo);
      font-size: 1.08rem;
      font-weight: 700;
      line-height: 1.5;
    }

    .risposte {
      display: grid;
      gap: 10px;
      max-width: 400px;
      margin: 0 auto;
    }

    .risposta {
      width: 100%;
      padding: 12px 14px;
      cursor: pointer;
      border: 2px solid #f0c9d3;
      border-radius: 14px;
      color: var(--testo);
      background: #fff;
      text-align: left;
      transition: background 0.2s ease, transform 0.2s ease;
      -webkit-tap-highlight-color: transparent;
    }

    .risposta:hover,
    .risposta:focus-visible {
      transform: translateY(-1px);
      background: #fff5f7;
    }

    .risposta.giusta {
      border-color: #8bbc8d;
      background: #edf9ed;
    }

    .risposta.sbagliata {
      border-color: #db8893;
      background: #fff0f1;
    }

    .risposta:disabled {
      cursor: default;
    }

    .dedica {
      position: relative;
      overflow: hidden;
      margin-top: 26px;
      padding: 36px 21px;
      border-radius: 28px;
      color: #fff;
      text-align: center;
      background: linear-gradient(135deg, #c65376, #e99aae);
      box-shadow: var(--ombra);
    }

    .dedica::before {
      content: "✦  ✦  ✦";
      position: absolute;
      top: 16px;
      left: 50%;
      width: 100%;
      color: rgba(255, 255, 255, 0.35);
      font-size: 20px;
      letter-spacing: 25px;
      transform: translateX(-50%);
    }

    .dedica h2 {
      margin-top: 18px;
      color: #fff;
    }

    .dedica p {
      max-width: 550px;
      margin: 0 auto;
      font-size: clamp(1rem, 3.9vw, 1.2rem);
      line-height: 1.75;
    }

    .firma {
      margin-top: 24px !important;
      font-family: Georgia, "Times New Roman", serif;
      font-size: 1.35rem !important;
      font-style: italic;
      font-weight: 700;
    }

    .footer {
      padding-top: 22px;
      color: #88656d;
      font-size: 0.86rem;
      text-align: center;
    }

    .coriandolo {
      position: fixed;
      top: -20px;
      z-index: 20;
      pointer-events: none;
      animation: caduta 2.4s linear forwards;
    }

    @keyframes pulsa {
      50% {
        transform: scale(1.12);
      }
    }

    @keyframes comparsa {
      from {
        opacity: 0;
        transform: translateY(8px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    @keyframes caduta {
      to {
        opacity: 0;
        transform: translateY(110vh) rotate(540deg);
      }
    }

    @media (max-width: 420px) {
      .pagina {
        padding: 12px 11px 30px;
      }

      .hero,
      .sezione,
      .dedica {
        border-radius: 22px;
      }

      .griglia-giochi {
        gap: 10px;
      }

      .scheda-gioco {
        min-height: 190px;
        padding: 15px 9px;
      }

      .scheda-gioco p {
        font-size: 0.84rem;
      }

      .pulsante-piccolo {
        padding: 9px 11px;
        font-size: 0.82rem;
      }
    }
  </style>
</head>

<body>
  <main class="pagina">
    <header class="hero">
      <div class="contenuto-hero">
        <span class="croce">✝</span>
        <h1>La comunione di Martina</h1>
        <p class="sottotitolo">
          Un giorno speciale da ricordare con il sorriso,
          la gioia e tanto affetto. <span class="cuore">♥</span>
        </p>
        <a class="pulsante pulsante-hero" href="#giochi">Scopri la sorpresa</a>
      </div>
    </header>

    <section class="sezione" id="giochi">
      <h2>Un piccolo mondo di giochi</h2>
      <p class="introduzione">
        Martina, scegli un gioco e divertiti! Ogni sorriso rende questo giorno
        ancora più bello.
      </p>

      <div class="griglia-giochi">
        <article class="scheda-gioco">
          <span class="icona-gioco">🃏</span>
          <h3>Trova le coppie</h3>
          <p>Scopri tutte le coppie di simboli speciali.</p>
          <button class="pulsante pulsante-piccolo" type="button" data-gioco="memory">
            Gioca
          </button>
        </article>

        <article class="scheda-gioco">
          <span class="icona-gioco">⭐</span>
          <h3>Acchiappa la stella</h3>
          <p>Tocca la stella più volte che puoi in 15 secondi.</p>
          <button class="pulsante pulsante-piccolo" type="button" data-gioco="stella">
            Gioca
          </button>
        </article>

        <article class="scheda-gioco">
          <span class="icona-gioco">❓</span>
          <h3>Quiz della gioia</h3>
          <p>Rispondi a una domanda dolce e speciale.</p>
          <button class="pulsante pulsante-piccolo" type="button" data-gioco="quiz">
            Gioca
          </button>
        </article>

        <article class="scheda-gioco">
          <span class="icona-gioco">🎉</span>
          <h3>Pioggia di festa</h3>
          <p>Fai comparire una pioggia di coriandoli colorati.</p>
          <button class="pulsante pulsante-piccolo" type="button" id="btn-coriandoli">
            Festa!
          </button>
        </article>
      </div>

      <div class="area-gioco" id="gioco-memory">
        <button class="chiudi-gioco" type="button" aria-label="Chiudi gioco">×</button>
        <h3>Trova le coppie</h3>
        <p>Trova le quattro coppie nascoste.</p>
        <div class="carte" id="carte-memory"></div>
        <p class="messaggio-gioco" id="messaggio-memory"></p>
      </div>

      <div class="area-gioco" id="gioco-stella">
        <button class="chiudi-gioco" type="button" aria-label="Chiudi gioco">×</button>
        <h3>Acchiappa la stella</h3>
        <p id="testo-stella">Premi “Inizia” e tocca la stella quando appare.</p>
        <button class="pulsante pulsante-piccolo" id="inizia-stella" type="button">
          Inizia
        </button>
        <div class="stella" id="campo-stella" aria-label="Campo di gioco">
          <button
            class="stella-bersaglio"
            id="bersaglio-stella"
            type="button"
            aria-label="Stella"
            hidden
          >
            ★
          </button>
        </div>
        <p class="messaggio-gioco" id="messaggio-stella"></p>
      </div>

      <div class="area-gioco" id="gioco-quiz">
        <button class="chiudi-gioco" type="button" aria-label="Chiudi gioco">×</button>
        <h3>Quiz della gioia</h3>
        <p class="quiz-domanda">Qual è la cosa più bella da regalare alle persone che amiamo?</p>
        <div class="risposte" id="risposte-quiz">
          <button class="risposta" type="button" data-corretta="false">Un brutto muso</button>
          <button class="risposta" type="button" data-corretta="true">Un sorriso e tanto affetto</button>
          <button class="risposta" type="button" data-corretta="false">La noia</button>
        </div>
        <p class="messaggio-gioco" id="messaggio-quiz"></p>
      </div>
    </section>

    <section class="dedica">
      <h2>Per te, Martina</h2>
      <p>
        Che questo giorno di comunione sia l’inizio di un cammino pieno di luce,
        di serenità, di sogni e di persone che ti vogliono bene.
      </p>
      <p>
        Conserva sempre nel cuore la tua dolcezza, il tuo sorriso e tutta la
        meraviglia che porti ogni giorno nella vita di chi ti è vicino.
      </p>
      <p class="firma">Con tanto amore,<br>Emy e Lulù ♥</p>
    </section>

    <footer class="footer">
      Realizzato con amore per un giorno indimenticabile.
    </footer>
  </main>

  <script>
    "use strict";

    const areeGioco = document.querySelectorAll(".area-gioco");
    const bottoniGioco = document.querySelectorAll("[data-gioco]");
    const bottoniChiudi = document.querySelectorAll(".chiudi-gioco");

    function chiudiGiochi() {
      areeGioco.forEach((area) => area.classList.remove("attiva"));
    }

    bottoniGioco.forEach((bottone) => {
      bottone.addEventListener("click", () => {
        const nomeGioco = bottone.dataset.gioco;
        const areaScelta = document.getElementById("gioco-" + nomeGioco);

        chiudiGiochi();
        areaScelta.classList.add("attiva");
        areaScelta.scrollIntoView({ behavior: "smooth", block: "center" });

        if (nomeGioco === "memory") {
          avviaMemory();
        }

        if (nomeGioco === "stella") {
          resetStella();
        }

        if (nomeGioco === "quiz") {
          resetQuiz();
        }
      });
    });

    bottoniChiudi.forEach((bottone) => {
      bottone.addEventListener("click", chiudiGiochi);
    });

    /* MEMORY */
    const simboliMemory = ["♥", "★", "✝", "🌸", "♥", "★", "✝", "🌸"];
    const carteMemory = document.getElementById("carte-memory");
    const messaggioMemory = document.getElementById("messaggio-memory");

    let primaCarta = null;
    let bloccaCarte = false;
    let coppieTrovate = 0;

    function mescola(elementi) {
      return [...elementi].sort(() => Math.random() - 0.5);
    }

    function avviaMemory() {
      primaCarta = null;
      bloccaCarte = false;
      coppieTrovate = 0;
      messaggioMemory.textContent = "";
      carteMemory.innerHTML = "";

      const carteMescolate = mescola(simboliMemory);

      carteMescolate.forEach((simbolo) => {
        const carta = document.createElement("button");
        carta.type = "button";
        carta.className = "carta";
        carta.dataset.simbolo = simbolo;
        carta.setAttribute("aria-label", "Carta da scoprire");
        carta.textContent = simbolo;

        carta.addEventListener("click", scopriCarta);
        carteMemory.appendChild(carta);
      });
    }

    function scopriCarta(evento) {
      const carta = evento.currentTarget;

      if (
        bloccaCarte ||
        carta === primaCarta ||
        carta.classList.contains("trovata") ||
        carta.classList.contains("scoperta")
      ) {
        return;
      }

      carta.classList.add("scoperta");

      if (!primaCarta) {
        primaCarta = carta;
        return;
      }

      if (primaCarta.dataset.simbolo === carta.dataset.simbolo) {
        primaCarta.classList.remove("scoperta");
        carta.classList.remove("scoperta");
        primaCarta.classList.add("trovata");
        carta.classList.add("trovata");

        coppieTrovate += 1;
        primaCarta = null;

        if (coppieTrovate === 4) {
          messaggioMemory.textContent = "Bravissima Martina! Hai trovato tutte le coppie! 🎉";
          creaCoriandoli();
        }
      } else {
        bloccaCarte = true;
        const cartaPrecedente = primaCarta;

        setTimeout(() => {
          cartaPrecedente.classList.remove("scoperta");
          carta.classList.remove("scoperta");
          primaCarta = null;
          bloccaCarte = false;
        }, 850);
      }
    }

    /* STELLA */
    const campoStella = document.getElementById("campo-stella");
    const bersaglioStella = document.getElementById("bersaglio-stella");
    const iniziaStella = document.getElementById("inizia-stella");
    const testoStella = document.getElementById("testo-stella");
    const messaggioStella = document.getElementById("messaggio-stella");

    let punteggioStella = 0;
    let giocoStellaAttivo = false;
    let timerStella = null;

    function resetStella() {
      clearInterval(timerStella);
      punteggioStella = 0;
      giocoStellaAttivo = false;
      bersaglioStella.hidden = true;
      iniziaStella.disabled = false;
      iniziaStella.textContent = "Inizia";
      testoStella.textContent = "Premi “Inizia” e tocca la stella quando appare.";
      messaggioStella.textContent = "";
    }

    function spostaStella() {
      const larghezza = campoStella.clientWidth;
      const altezza = campoStella.clientHeight;
      const dimensione = 55;

      const sinistra = Math.random() * Math.max(1, larghezza - dimensione);
      const alto = Math.random() * Math.max(1, altezza - dimensione);

      bersaglioStella.style.left = sinistra + "px";
      bersaglioStella.style.top = alto + "px";
    }

    iniziaStella.addEventListener("click", () => {
      if (giocoStellaAttivo) {
        return;
      }

      punteggioStella = 0;
      giocoStellaAttivo = true;
      bersaglioStella.hidden = false;
      iniziaStella.disabled = true;
      messaggioStella.textContent = "";
      spostaStella();

      let secondi = 15;
      testoStella.textContent = "Tempo rimasto: " + secondi + " secondi";

      timerStella = setInterval(() => {
        secondi -= 1;
        testoStella.textContent = "Tempo rimasto: " + secondi + " secondi";

        if (secondi <= 0) {
          clearInterval(timerStella);
          giocoStellaAttivo = false;
          bersaglioStella.hidden = true;
          iniziaStella.disabled = false;
          iniziaStella.textContent = "Rigioca";
          testoStella.textContent = "Tempo finito!";
          messaggioStella.textContent =
            "Hai acchiappato " +
            punteggioStella +
            (punteggioStella === 1 ? " stella! ⭐" : " stelle! ⭐");

          if (punteggioStella >= 10) {
            creaCoriandoli();
          }
        }
      }, 1000);
    });

    bersaglioStella.addEventListener("click", () => {
      if (!giocoStellaAttivo) {
        return;
      }

      punteggioStella += 1;
      spostaStella();
    });

    /* QUIZ */
    const risposteQuiz = document.querySelectorAll(".risposta");
    const messaggioQuiz = document.getElementById("messaggio-quiz");

    function resetQuiz() {
      messaggioQuiz.textContent = "";

      risposteQuiz.forEach((risposta) => {
        risposta.disabled = false;
        risposta.classList.remove("giusta", "sbagliata");
      });
    }

    risposteQuiz.forEach((risposta) => {
      risposta.addEventListener("click", () => {
        const corretta = risposta.dataset.corretta === "true";

        risposteQuiz.forEach((elemento) => {
          elemento.disabled = true;

          if (elemento.dataset.corretta === "true") {
            elemento.classList.add("giusta");
          }
        });

        if (corretta) {
          messaggioQuiz.textContent = "Esatto! L’affetto è sempre il regalo più bello. ♥";
          creaCoriandoli();
        } else {
          risposta.classList.add("sbagliata");
          messaggioQuiz.textContent = "Quasi! La risposta giusta è: un sorriso e tanto affetto. ♥";
        }
      });
    });

    /* CORIANDOLI */
    const bottoneCoriandoli = document.getElementById("btn-coriandoli");

    bottoneCoriandoli.addEventListener("click", creaCoriandoli);

    function creaCoriandoli() {
      const simboli = ["♥", "★", "✦", "🌸", "•"];
      const colori = ["#d75d80", "#efb5c4", "#c9a35e", "#ffffff", "#ab4567"];

      for (let i = 0; i < 40; i += 1) {
        const coriandolo = document.createElement("span");
        coriandolo.className = "coriandolo";
        coriandolo.textContent = simboli[Math.floor(Math.random() * simboli.length)];
        coriandolo.style.left = Math.random() * 100 + "vw";
        coriandolo.style.color = colori[Math.floor(Math.random() * colori.length)];
        coriandolo.style.fontSize = 14 + Math.random() * 20 + "px";
        coriandolo.style.animationDuration = 1.8 + Math.random() * 1.8 + "s";
        coriandolo.style.animationDelay = Math.random() * 0.45 + "s";

        document.body.appendChild(coriandolo);

        setTimeout(() => {
          coriandolo.remove();
        }, 4200);
      }
    }
  </script>
</body>
</html>
