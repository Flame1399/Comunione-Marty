<script>
"use strict";

document.addEventListener("DOMContentLoaded", function () {

  var aree = document.querySelectorAll(".area-gioco");
  var bottoni = document.querySelectorAll("[data-gioco]");
  var chiudi = document.querySelectorAll(".chiudi-gioco");

  function chiudiTutti() {
    aree.forEach(function (a) {
      a.classList.remove("attiva");
    });
  }

  bottoni.forEach(function (b) {
    b.addEventListener("click", function () {
      var nome = this.getAttribute("data-gioco");
      var area = document.getElementById("gioco-" + nome);

      if (!area) return;

      chiudiTutti();
      area.classList.add("attiva");

      setTimeout(function () {
        area.scrollIntoView({
          behavior: "smooth",
          block: "center"
        });
      }, 100);

      if (nome === "memory") avviaMemory();
      if (nome === "stella") resetStella();
      if (nome === "quiz") resetQuiz();
    });
  });

  chiudi.forEach(function (b) {
    b.addEventListener("click", chiudiTutti);
  });


  /* MEMORY */
  var simboli = ["♥", "★", "✝", "🌸", "♥", "★", "✝", "🌸"];
  var carte = document.getElementById("carte-memory");
  var msgMemory = document.getElementById("messaggio-memory");

  var prima = null;
  var blocca = false;
  var coppie = 0;

  function mescola(array) {
    var a = array.slice();
    for (var i = a.length - 1; i > 0; i--) {
      var j = Math.floor(Math.random() * (i + 1));
      var tmp = a[i];
      a[i] = a[j];
      a[j] = tmp;
    }
    return a;
  }

  function avviaMemory() {
    prima = null;
    blocca = false;
    coppie = 0;
    msgMemory.textContent = "";
    carte.innerHTML = "";

    mescola(simboli).forEach(function (simbolo) {
      var carta = document.createElement("button");
      carta.type = "button";
      carta.className = "carta";
      carta.textContent = simbolo;
      carta.setAttribute("data-simbolo", simbolo);

      carta.addEventListener("click", function () {
        if (
          blocca ||
          carta === prima ||
          carta.classList.contains("trovata") ||
          carta.classList.contains("scoperta")
        ) return;

        carta.classList.add("scoperta");

        if (!prima) {
          prima = carta;
          return;
        }

        if (prima.getAttribute("data-simbolo") === carta.getAttribute("data-simbolo")) {
          prima.classList.remove("scoperta");
          carta.classList.remove("scoperta");

          prima.classList.add("trovata");
          carta.classList.add("trovata");

          coppie++;
          prima = null;

          if (coppie === 4) {
            msgMemory.textContent = "Bravissima Martina! Hai trovato tutte le coppie! 🎉";
            creaCoriandoli();
          }
        } else {
          blocca = true;
          var precedente = prima;

          setTimeout(function () {
            precedente.classList.remove("scoperta");
            carta.classList.remove("scoperta");
            prima = null;
            blocca = false;
          }, 700);
        }
      });

      carte.appendChild(carta);
    });
  }


  /* STELLA */
  var campo = document.getElementById("campo-stella");
  var stella = document.getElementById("bersaglio-stella");
  var inizia = document.getElementById("inizia-stella");
  var testo = document.getElementById("testo-stella");
  var msgStella = document.getElementById("messaggio-stella");

  var punti = 0;
  var attivo = false;
  var timer = null;

  function resetStella() {
    if (timer) clearInterval(timer);
    punti = 0;
    attivo = false;
    stella.hidden = true;
    inizia.disabled = false;
    inizia.textContent = "Inizia";
    testo.textContent = "Premi “Inizia” e tocca la stella quando appare.";
    msgStella.textContent = "";
  }

  function spostaStella() {
    var w = campo.clientWidth;
    var h = campo.clientHeight;

    var maxX = Math.max(0, w - 60);
    var maxY = Math.max(0, h - 60);

    var x = Math.floor(Math.random() * maxX);
    var y = Math.floor(Math.random() * maxY);

    stella.style.left = x + "px";
    stella.style.top = y + "px";
  }

  inizia.addEventListener("click", function () {
    if (attivo) return;

    punti = 0;
    attivo = true;
    stella.hidden = false;
    inizia.disabled = true;
    msgStella.textContent = "";

    spostaStella();

    var secondi = 15;
    testo.textContent = "Tempo rimasto: " + secondi + " secondi";

    timer = setInterval(function () {
      secondi--;
      testo.textContent = "Tempo rimasto: " + secondi + " secondi";

      if (secondi <= 0) {
        clearInterval(timer);
        attivo = false;
        stella.hidden = true;
        inizia.disabled = false;
        inizia.textContent = "Rigioca";
        testo.textContent = "Tempo finito!";
        msgStella.textContent = "Hai acchiappato " + punti + (punti === 1 ? " stella! ⭐" : " stelle! ⭐");

        if (punti >= 10) creaCoriandoli();
      }
    }, 1000);
  });

  stella.addEventListener("click", function () {
    if (!attivo) return;
    punti++;
    spostaStella();
  });


  /* QUIZ */
  var risposte = document.querySelectorAll(".risposta");
  var msgQuiz = document.getElementById("messaggio-quiz");

  function resetQuiz() {
    msgQuiz.textContent = "";
    risposte.forEach(function (r) {
      r.disabled = false;
      r.classList.remove("giusta", "sbagliata");
    });
  }

  risposte.forEach(function (r) {
    r.addEventListener("click", function () {
      var corretta = this.getAttribute("data-corretta") === "true";

      risposte.forEach(function (x) {
        x.disabled = true;
        if (x.getAttribute("data-corretta") === "true") {
          x.classList.add("giusta");
        }
      });

      if (corretta) {
        msgQuiz.textContent = "Esatto! L’affetto è sempre il regalo più bello. ♥";
        creaCoriandoli();
      } else {
        this.classList.add("sbagliata");
        msgQuiz.textContent = "Quasi! La risposta giusta è: un sorriso e tanto affetto. ♥";
      }
    });
  });


  /* CORIANDOLI */
  var btnCoriandoli = document.getElementById("btn-coriandoli");
  if (btnCoriandoli) {
    btnCoriandoli.addEventListener("click", creaCoriandoli);
  }

  function creaCoriandoli() {
    var simboli = ["♥", "★", "✦", "🌸", "•"];
    var colori = ["#d75d80", "#efb5c4", "#c9a35e", "#ffffff", "#ab4567"];

    for (var i = 0; i < 35; i++) {
      var c = document.createElement("span");
      c.className = "coriandolo";
      c.textContent = simboli[Math.floor(Math.random() * simboli.length)];
      c.style.left = Math.random() * 95 + "vw";
      c.style.color = colori[Math.floor(Math.random() * colori.length)];
      c.style.fontSize = (14 + Math.random() * 18) + "px";
      c.style.animationDuration = (1.8 + Math.random() * 1.8) + "s";
      c.style.animationDelay = (Math.random() * 0.4) + "s";

      document.body.appendChild(c);

      (function (elem) {
        setTimeout(function () {
          if (elem && elem.parentNode) {
            elem.parentNode.removeChild(elem);
          }
        }, 4000);
      })(c);
    }
  }

});
</script>
